TYPESAFE_API_KEY=
JEV_PROVIDER=typesafe
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-1.13.0
LOCAL_JEV_API_KEY=
# 비워 두면 typesafe는 4, local은 1개 요청을 동시에 실행합니다.
JEV_CONCURRENCY=
# 로컬 요청 제한, 전체 판단 예산(config.yaml의 기본 8초) 내에서 적용합니다.
LOCAL_JEV_TIMEOUT_SECONDS=7
# 통합 로컬 Compose에서 모델을 바꾸면 실험 ID도 함께 바꾸세요.
LOCAL_JEV_MODEL=tev1:0.8b
LOCAL_LAB_RUN_ID=krw-local-tev08-1m-v1
LOCAL_TOURNAMENT_ID=jev-tournament-7d-local-v2
CRYPTO_DATA_PROVIDER=upbit
CRYPTO_API_KEY=
STOCK_DATA_PROVIDER=kis
STOCK_API_KEY=
STOCK_API_SECRET=
# 키움 REST: STOCK_DATA_PROVIDER=kiwoom으로 선택합니다. KIS 키와 별도로 관리합니다.
KIWOOM_APP_KEY=
KIWOOM_SECRET_KEY=
KIWOOM_API_ENV=live
STOCK_FEED=iex
LAB_MODE=LIVE_PAPER
LAB_RUN_ID=krw-scalp-1m-v2
LAB_TOURNAMENT_ID=jev-tournament-7d-v1
LAB_AUTOSTART=true
POSTGRES_PASSWORD=local-paper-lab
# 서버에서 LAN 접속을 허용하려면 0.0.0.0으로 설정합니다.
DASHBOARD_BIND_ADDRESS=127.0.0.1
